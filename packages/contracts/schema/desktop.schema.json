{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:reopen:schema:desktop",
  "title": "DesktopPayload",
  "description": "Payloads of desktop-role operations (docs/PROTOCOL.md). Requests use kind `<operation>`; successful responses use `<operation>.result` with the matching result payload.",
  "oneOf": [
    {
      "$ref": "#/definitions/EmptyRequest"
    },
    {
      "$ref": "#/definitions/StatusResult"
    },
    {
      "$ref": "#/definitions/CaptureRequestResult"
    },
    {
      "$ref": "#/definitions/CheckpointsListRequest"
    },
    {
      "$ref": "#/definitions/CheckpointsListResult"
    },
    {
      "$ref": "#/definitions/CheckpointGetRequest"
    },
    {
      "$ref": "#/definitions/CheckpointDetail"
    },
    {
      "$ref": "#/definitions/RestorePreviewRequest"
    },
    {
      "$ref": "#/definitions/RestorePlan"
    },
    {
      "$ref": "#/definitions/RestoreStartRequest"
    },
    {
      "$ref": "#/definitions/RestoreRunRef"
    },
    {
      "$ref": "#/definitions/RestoreCancelResult"
    },
    {
      "$ref": "#/definitions/RestoreStatus"
    }
  ],
  "definitions": {
    "Timestamp": {
      "description": "UTC timestamp with whole seconds, RFC 3339 (YYYY-MM-DDTHH:MM:SSZ).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "EmptyRequest": {
      "description": "Request payload for status.get and capture.request.",
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "CaptureMode": {
      "type": "string",
      "enum": ["active", "paused"]
    },
    "CaptureReason": {
      "type": "string",
      "enum": ["scheduled", "manual", "shutdown"]
    },
    "Completeness": {
      "type": "string",
      "enum": ["complete", "partial"]
    },
    "SourceState": {
      "type": "string",
      "enum": ["complete", "partial", "unavailable", "stale", "excluded", "unsupported"]
    },
    "ResourceKind": {
      "type": "string",
      "enum": ["application", "project", "folder", "browser_tab"]
    },
    "CheckpointSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "session_id",
        "captured_at",
        "reason",
        "completeness",
        "resource_count",
        "protected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "captured_at": {
          "$ref": "#/definitions/Timestamp"
        },
        "reason": {
          "$ref": "#/definitions/CaptureReason"
        },
        "completeness": {
          "$ref": "#/definitions/Completeness"
        },
        "resource_count": {
          "type": "integer",
          "minimum": 0
        },
        "protected": {
          "description": "Pinned or a pending recovery candidate.",
          "type": "boolean"
        }
      }
    },
    "StatusResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_version",
        "protocol_version",
        "session_id",
        "capture",
        "last_checkpoint",
        "pending_candidates"
      ],
      "properties": {
        "agent_version": {
          "type": "string",
          "maxLength": 64
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "capture": {
          "$ref": "#/definitions/CaptureMode"
        },
        "last_checkpoint": {
          "oneOf": [
            {
              "$ref": "#/definitions/CheckpointSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_candidates": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CaptureRequestResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted"],
      "properties": {
        "accepted": {
          "description": "False when a request was already pending and this one was merged into it.",
          "type": "boolean"
        }
      }
    },
    "CheckpointsListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit"],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "CheckpointsListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoints"],
      "properties": {
        "checkpoints": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/CheckpointSummary"
          }
        }
      }
    },
    "CheckpointGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "SourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "state", "required", "captured_at", "error"],
      "properties": {
        "source_key": {
          "type": "string",
          "maxLength": 128
        },
        "state": {
          "$ref": "#/definitions/SourceState"
        },
        "required": {
          "type": "boolean"
        },
        "captured_at": {
          "oneOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ResourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind", "adapter_id", "label"],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/definitions/ResourceKind"
        },
        "adapter_id": {
          "type": "string",
          "maxLength": 128
        },
        "label": {
          "description": "App ID, path or address shown to the user. Never logged.",
          "type": "string",
          "maxLength": 8192
        }
      }
    },
    "CheckpointDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "sources", "resources"],
      "properties": {
        "summary": {
          "$ref": "#/definitions/CheckpointSummary"
        },
        "sources": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/SourceSummary"
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/definitions/ResourceSummary"
          }
        }
      }
    },
    "RunState": {
      "type": "string",
      "enum": ["queued", "running", "paused", "completed", "cancelled", "interrupted"]
    },
    "ActionState": {
      "type": "string",
      "enum": ["pending", "launching", "restored", "already_open", "failed", "skipped", "uncertain"]
    },
    "Disposition": {
      "type": "string",
      "enum": ["launch", "already_open", "skip"]
    },
    "RestorePreviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id"],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "format": "uuid"
        },
        "only": {
          "description": "Resource ordinals to include (at least one); all resources when omitted.",
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        }
      }
    },
    "PlannedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind", "label", "disposition", "reason", "possible_duplicate"],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/definitions/ResourceKind"
        },
        "label": {
          "type": "string",
          "maxLength": 8192
        },
        "disposition": {
          "$ref": "#/definitions/Disposition"
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "possible_duplicate": {
          "description": "Could not rule out that the app is already open; launches only if allowed.",
          "type": "boolean"
        }
      }
    },
    "RestorePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "checkpoint_id", "expires_in_seconds", "warnings", "actions"],
      "properties": {
        "plan_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint_id": {
          "type": "string",
          "format": "uuid"
        },
        "expires_in_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/definitions/PlannedAction"
          }
        }
      }
    },
    "RestoreStartRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "allow_possible_duplicates"],
      "properties": {
        "plan_id": {
          "type": "string",
          "format": "uuid"
        },
        "allow_possible_duplicates": {
          "type": "boolean"
        }
      }
    },
    "RestoreRunRef": {
      "description": "Result of restore.start; request of restore.status and restore.cancel.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id"],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "RestoreCancelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancelled"],
      "properties": {
        "cancelled": {
          "description": "False when the run had already finished.",
          "type": "boolean"
        }
      }
    },
    "RestoreActionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "label", "state", "result"],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 8192
        },
        "state": {
          "$ref": "#/definitions/ActionState"
        },
        "result": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RestoreStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "checkpoint_id", "state", "created_at", "completed_at", "actions"],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/definitions/RunState"
        },
        "created_at": {
          "$ref": "#/definitions/Timestamp"
        },
        "completed_at": {
          "oneOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/definitions/RestoreActionStatus"
          }
        }
      }
    }
  }
}
