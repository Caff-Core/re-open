{
  "name": "re-open",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.15.0 <13"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "contracts:generate": "node scripts/pending.mjs contracts:generate 0.9",
    "contracts:check": "node scripts/pending.mjs contracts:check 0.9",
    "dev:desktop": "node scripts/pending.mjs dev:desktop 0.7",
    "dev:agent": "node scripts/pending.mjs dev:agent 1.8",
    "dev:extension": "node scripts/pending.mjs dev:extension 3.4",
    "package:linux": "node scripts/pending.mjs package:linux 6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
